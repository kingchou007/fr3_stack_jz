{
  "schema": "fr3_joint_trajectory_campaign/v1",
  "purpose": "Small-range pilot excitation, not a guaranteed identifiable dynamics dataset",
  "profile": "sysid_stiff",
  "filter_policy": "Keep the profile EMA unchanged; no filter-alpha override",
  "required_controller": "joint_impedance",
  "execution_policy": "Review each stage independently; no automatic progression or mode switching",
  "reference_designs": {
    "frankatwin_joint": {
