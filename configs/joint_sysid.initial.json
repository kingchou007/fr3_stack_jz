      "source_paths": ["python/frankatwin/excitation/chirp.py", "python/frankatwin/excitation/multiband.py"],
      "adaptations": [
        "Joint-space references, not Cartesian references or inverse kinematics",
        "Seven-joint chirp phase spacing 2*pi/7 instead of six-axis pi/3",
        "Held-out tone rows reassigned in source axis order to J1 through J7; not a physical axis mapping",
        "Peak-normalized small joint excursions; unchanged reference limits and controller EMA",
        "Longer trials and existing C3 envelopes instead of upstream ramps",
        "No high-band chirp or upstream gain/collision configuration"
      ]
    }
  },
